{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Omnex System Signal Specification",
  "description": "Signal declaration schema used by MasterRouter and ERP Rails.",
  "type": "object",
  "properties": {
    "signal_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique signal identifier"
    },
    "source_system_code": {
      "type": "string",
      "description": "System that emitted the signal"
    },
    "event_code": {
      "type": "string",
      "description": "Linked event code"
    },
    "trigger_type": {
      "type": "string",
      "enum": ["manual", "system", "external", "inference"],
      "description": "What caused this signal"
    },
    "signal_name": {
      "type": "string",
      "description": "Canonical name of the signal"
    },
    "payload_schema_ref": {
      "type": "string",
      "description": "Reference to JSON schema of signal payload"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"],
      "description": "Routing urgency"
    },
    "router_policy": {
      "type": "string",
      "description": "Declared MasterRouter logic reference"
    },
    "erp_rail_track": {
      "type": "string",
      "description": "Which ERP Rail should dispatch it"
    },
    "requires_audit": {
      "type": "boolean",
      "description": "True if signal is mandated for audit"
    }
  },
  "required": ["signal_id", "source_system_code", "event_code", "trigger_type", "signal_name"]
}
